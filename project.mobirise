          "_name": "content5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5 tb-grid\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"12\" step=\"1\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#fff7f0\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-6 col-lg-3 item\">\n                <img src=\"@PROJECT_PATH@/assets/images/icon-beginner-300x300.png\" alt=\"Beginner friendly\">\n                <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\"><b>Beginner Friendly</b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\">Made for people with no tech skills or prior experience.</p>\n            </div>\n            <div class=\"col-6 col-lg-3 item\">\n                <img src=\"@PROJECT_PATH@/assets/images/icon-video-300x300.png\" alt=\"Video training\">\n                <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\"><b>Video Training</b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\">Follow-along lessons that walk you through every step.</p>\n            </div>\n            <div class=\"col-6 col-lg-3 item\">\n                <img src=\"@PROJECT_PATH@/assets/images/icon-mobile-300x300.png\" alt=\"Works on any device\">\n                <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\"><b>Any Device</b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\">Open the members area from your phone, tablet or computer.</p>\n            </div>\n            <div class=\"col-6 col-lg-3 item\">\n                <img src=\"@PROJECT_PATH@/assets/images/icon-refund-300x300.png\" alt=\"Refund backed\">\n                <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\"><b>Refund Backed</b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\">Try it for 100 days — if it’s not for you, ask for a refund.</p>\n            </div>\n        </div>\n    </div>\n</section>",
